# DevAgent harness configuration for THIS repository (the target).
# Read by the engine's guards and scripts at hook/run time, with CWD = this
# repo. Keep the commands in sync with this repo's CLAUDE.md command table —
# agents read the table, scripts read this file.

# Where the DevAgent engine lives. Stamped by harness-init; agents use it to
# reach the engine's scripts and templates.
HARNESS_ENGINE_ROOT="__ENGINE_ROOT__"

# Full test suite. Required. Must be safe to run unattended — never a
# command that costs money or touches production systems.
HARNESS_TEST_CMD="TODO"

# Run one test file. {file} is the placeholder. Strongly preferred: without
# it, verify-new-tests.sh can only say that SOME new test is tautological,
# not which one.
HARNESS_TEST_ONE_CMD=""

# Default branch. Task branches are cut from here and diffed against it.
HARNESS_BASE_BRANCH="main"

# Space-separated test directories.
HARNESS_TEST_PATHS="tests"

# Roadmap location. Holds this repo's backlog in R-NNN format.
HARNESS_ROADMAP="docs/roadmap.md"

# Write scope for the implementer role: an extended regex over repo-relative
# paths. REQUIRED — the write guard blocks all implementer writes when unset.
# Optional deny pattern is checked first.
HARNESS_IMPLEMENTER_SCOPE="TODO"
HARNESS_IMPLEMENTER_DENY=""

# Write scope for the reviewer role (default shown).
#HARNESS_REVIEWER_SCOPE="^(docs/|\.harness/state/review\.md$)"
