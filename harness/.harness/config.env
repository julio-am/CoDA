# Harness configuration. Sourced by scripts/harness-status.sh and
# scripts/verify-new-tests.sh. Keep these in sync with the command table in
# CLAUDE.md — the agents read that table, the scripts read this file.

# Full test suite. Required.
HARNESS_TEST_CMD="TODO"

# Run one test file. Optional but strongly preferred: without it,
# verify-new-tests.sh can only tell you that SOME new test is tautological,
# not which one. Use {file} as the placeholder.
#   pytest:  "python3 -m pytest -q {file}"
#   ctest:   "ctest --test-dir build -R $(basename {file} .cpp) --output-on-failure"
#   go:      "go test ./$(dirname {file})/..."
#   cargo:   "cargo test --test $(basename {file} .rs)"
HARNESS_TEST_ONE_CMD=""

# Default branch. Task branches are cut from here and diffed against it.
HARNESS_BASE_BRANCH="main"

# Space-separated test directories.
HARNESS_TEST_PATHS="tests"

# Roadmap location.
HARNESS_ROADMAP="docs/roadmap.md"
